        "\n",
        "    # 1. Loop FOR untuk menghitung total pemakaian listrik\n",
        "    total_pemakaian_kwh = 0\n",
        "    for pemakaian in pemakaian_bulanan:\n",
        "        total_pemakaian_kwh += pemakaian  # jumlahkan semua data pemakaian\n",
        "\n",
        "    # 2. Hitung biaya dasar\n",
        "    biaya_dasar = total_pemakaian_kwh * tarif_dasar_per_kwh\n",
        "    selisih_kwh = total_pemakaian_kwh - target_kwh\n",
        "    total_biaya = biaya_dasar\n",
        "\n",
        "    # 3. Tampilkan hasil sementara\n",
        "    print(f\"Total Pemakaian: {total_pemakaian_kwh:.2f} kWh\")\n",
