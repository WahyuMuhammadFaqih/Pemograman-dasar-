        "# Fungsi untuk menghitung mundur dari angka tertentu (while loop)\n",
        "def hitung_mundur(n):\n",
        "    while n > 0:\n",
        "        print(n)\n",
        "        n -= 1\n",
        "    print(\"Selesai menghitung mundur!\")\n",
        "\n",
        "# Bagian Output Program\n",
        "\n",
