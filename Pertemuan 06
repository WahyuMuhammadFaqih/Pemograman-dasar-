        "# Contoh fungsi lengkap buatan sendiri\n",
        "def analisa_data(daftar_nilai):\n",
        "    # Tipe data non primitif\n",
        "    data_tuple = tuple(daftar_nilai)\n",
        "    data_set = set(daftar_nilai)\n",
        "    data_dict = {\"jumlah\": len(daftar_nilai), \"unik\": len(data_set)}\n",
        "\n",
        "    # Tipe data primitif\n",
        "    total = 0\n",
        "    lulus = True\n",
        "\n",
        "    # Perulangan\n",
        "    for nilai in daftar_nilai:\n",
        "        total += nilai\n",
        "\n",
        "    rata_rata = total / len(daftar_nilai)\n",
        "\n",
        "    # Percabangan\n",
        "    if rata_rata >= 80:\n",
        "        status = \"Lulus\"\n",
        "    elif rata_rata >= 65:\n",
        "        status = \"Remedial\"\n",
        "        lulus = False\n",
        "    else:\n",
        "        status = \"Tidak Lulus\"\n",
        "        lulus = False\n",
        "\n",
        "    print(f\"Tuple: {data_tuple}\")\n",
        "    print(f\"Set unik: {data_set}\")\n",
        "    print(f\"Dictionary: {data_dict}\")\n",
        "    print(f\"Rata-rata nilai: {rata_rata}\")\n",
        "    print(f\"Status: {status}\")\n",
        "    print(f\"Lulus? {lulus}\")\n",
        "\n",
        "# Pemanggilan fungsi\n",
        "nilai_siswa = [95, 75, 85, 60, 80]\n",
        "analisa_data(nilai_siswa)"
      ],
